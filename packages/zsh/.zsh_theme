# vim: fdm=marker
# for EPOCHSECONDS, rather than a sub-shell to $(date +%s)
zmodload zsh/datetime

export LONG_CMD_NOTIFY_THRESHOLD=30
# {{{
LONG_CMD_IGNORED+=(
    anon-ssh
    bat
    cat
    diary
    docker
    fg
    less
    khal
    man
    neomutt
    nvim
    pdiary
    pwiki
    ssh
    sshpass
    sudoedit
    tail
    tmux
    vi
    vim
    wdiary
    wiki
    wwiki
    zn
    zs
    zz
)
# -U: dedupe the array in place, keeping the first occurrence of each command
typeset -U LONG_CMD_IGNORED
# }}}

# bat THEME {{{
export BAT_THEME="gruvbox-dark"
# }}}

# THEME --------------------------------{{{
source ~/.zsh_theme_vars

in-virtualenv() { #{{{
    if [[ -n $VIRTUAL_ENV ]]; then
        local venv
        venv=${${(s:/:)VIRTUAL_ENV}[-1]}
        if [[ $venv == 'env' ]]; then
            venv=${${(s:/:)VIRTUAL_ENV}[-2]}
        fi
        echo -n "${ZSH_THEME_PREFIX}${ZSH_THEME_REPO_COLOR}$ZSH_THEME_SEPARATOR${ZSH_THEME_VENV_COLOR}${venv}%{$reset_color%}$ZSH_THEME_SUFFIX"
    fi
} #}}}
aws-profile() { #{{{
    if [[ -n $AWS_PROFILE ]]; then
        echo -n "${ZSH_THEME_PREFIX}${ZSH_THEME_REPO_COLOR}$ZSH_THEME_SEPARATOR${ZSH_THEME_AWS_COLOR}${AWS_PROFILE}%{$reset_color%}$ZSH_THEME_SUFFIX"
    fi
} #}}}
nvm-version() { #{{{
    if [[ -n $NVM_BIN ]]; then
        local nvm_ver
        nvm_ver=${${(s:/:)NVM_BIN}[-2]}
        echo -n "${ZSH_THEME_PREFIX}${ZSH_THEME_REPO_COLOR}$ZSH_THEME_SEPARATOR${ZSH_THEME_NVM_COLOR}$nvm_ver%{$reset_color%}$ZSH_THEME_SUFFIX"
    fi
}
#}}}
in-upterm() { #{{{
    if [[ ! -z "${UPTERM_ADMIN_SOCKET}" ]]; then
        echo -n "${ZSH_THEME_PREFIX}${ZSH_THEME_SUFFIX}"
    fi
}
#}}}
# git prompt (romkatv/gitstatus) {{{
# git_super_status re-implemented on gitstatusd; renders with the same
# ZSH_THEME_GIT_PROMPT_* vars (and output format) as the old zsh-git-prompt
if (( ${+functions[gitstatus_start]} )); then
    # -1: unlimited counts (defaults cap staged/unstaged/conflicted/untracked at 1)
    gitstatus_start -s -1 -u -1 -c -1 -d -1 'THEME'
fi
git_super_status() {
    (( ${+functions[gitstatus_query]} )) || return
    gitstatus_query -t 1 'THEME' 2>/dev/null || return
    [[ $VCS_STATUS_RESULT == ok-sync ]] || return
    local reset="%{${reset_color}%}"

    local branch=$VCS_STATUS_LOCAL_BRANCH
    [[ -z $branch ]] && branch="${ZSH_THEME_GIT_PROMPT_HASH_PREFIX:-:}${VCS_STATUS_COMMIT[1,7]}"
    local s="${reset}${ZSH_THEME_GIT_PROMPT_PREFIX}${ZSH_THEME_GIT_PROMPT_BRANCH}${branch//\%/%%}${reset}"

    case $VCS_STATUS_ACTION in
        (rebase*|am|am/rebase) s+="${ZSH_THEME_GIT_PROMPT_REBASE}${reset}" ;;
        (merge)                s+="${ZSH_THEME_GIT_PROMPT_MERGING}${reset}" ;;
        (bisect)               s+="${ZSH_THEME_GIT_PROMPT_BISECT}${reset}" ;;
    esac

    if [[ -n $VCS_STATUS_LOCAL_BRANCH && -z $VCS_STATUS_REMOTE_BRANCH ]]; then
        s+="${ZSH_THEME_GIT_PROMPT_LOCAL}${reset}"
    elif [[ ${ZSH_GIT_PROMPT_SHOW_UPSTREAM:-0} -gt 0 && -n $VCS_STATUS_REMOTE_BRANCH ]]; then
        local upstream="${VCS_STATUS_REMOTE_NAME}/${VCS_STATUS_REMOTE_BRANCH}"
        # SHOW_UPSTREAM=2: collapse origin/foo to origin when tracking same-named branch
        if [[ ${ZSH_GIT_PROMPT_SHOW_UPSTREAM} -eq 2 && $VCS_STATUS_REMOTE_BRANCH == $VCS_STATUS_LOCAL_BRANCH ]]; then
            upstream=$VCS_STATUS_REMOTE_NAME
        fi
        s+="${ZSH_THEME_GIT_PROMPT_UPSTREAM_FRONT}${upstream//\%/%%}${ZSH_THEME_GIT_PROMPT_UPSTREAM_END}${reset}"
    fi

    if (( VCS_STATUS_COMMITS_BEHIND || VCS_STATUS_COMMITS_AHEAD )); then
        s+="$ZSH_THEME_GIT_PROMPT_BEHIND_AHEAD_SECTION_SEPARATOR"
    fi
    (( VCS_STATUS_COMMITS_BEHIND )) && s+="${ZSH_THEME_GIT_PROMPT_BEHIND}${VCS_STATUS_COMMITS_BEHIND}${reset}"
    (( VCS_STATUS_COMMITS_BEHIND && VCS_STATUS_COMMITS_AHEAD )) && s+="$ZSH_THEME_GIT_PROMPT_BEHIND_AHEAD_SEPARATOR"
    (( VCS_STATUS_COMMITS_AHEAD )) && s+="${ZSH_THEME_GIT_PROMPT_AHEAD}${VCS_STATUS_COMMITS_AHEAD}${reset}"

    s+="$ZSH_THEME_GIT_PROMPT_SEPARATOR"

    (( VCS_STATUS_NUM_STAGED ))     && s+="${ZSH_THEME_GIT_PROMPT_STAGED}${VCS_STATUS_NUM_STAGED}${reset}"
    (( VCS_STATUS_NUM_CONFLICTED )) && s+="${ZSH_THEME_GIT_PROMPT_CONFLICTS}${VCS_STATUS_NUM_CONFLICTED}${reset}"
    (( VCS_STATUS_NUM_UNSTAGED ))   && s+="${ZSH_THEME_GIT_PROMPT_CHANGED}${VCS_STATUS_NUM_UNSTAGED}${reset}"
    (( VCS_STATUS_NUM_UNTRACKED ))  && s+="${ZSH_THEME_GIT_PROMPT_UNTRACKED}${VCS_STATUS_NUM_UNTRACKED}${reset}"
    (( VCS_STATUS_STASHES ))        && s+="${ZSH_THEME_GIT_PROMPT_STASHED}${VCS_STATUS_STASHES}${reset}"

    if (( ! (VCS_STATUS_NUM_STAGED || VCS_STATUS_NUM_CONFLICTED || VCS_STATUS_NUM_UNSTAGED \
             || VCS_STATUS_NUM_UNTRACKED || VCS_STATUS_STASHES) )); then
        s+="${ZSH_THEME_GIT_PROMPT_CLEAN}${reset}"
    fi

    s+="${ZSH_THEME_GIT_PROMPT_SUFFIX}${reset}"
    echo -n "$s"
}
#}}}
# Setup vim mode and rprompt {{{
# -g: force global scope (this file is sourced inside _init_full_prompt, so a
#     plain `typeset -a` would create a function-local that dies on return).
# -a: indexed array.
typeset -ga RPROMPT_CMDS
RPROMPT_CMDS+=( in-upterm aws-profile in-virtualenv nvm-version )
# Re-assert attributes after the append: -g global, -U dedupe (so a duplicate
# from ~/.local_zshrc collapses), -x export (a no-op on arrays, kept for intent).
typeset -gUx RPROMPT_CMDS
function zle-line-init zle-keymap-select {
    case $CONTEXT {
        ('start')
            if [ -z "$CHAT_TERM" ]; then
                VIM_PROMPT="$prompt_l_sqparen%b%F{yellow}NORMAL$prompt_r_sqparen"
                local_prompt="${${KEYMAP/vicmd/$VIM_PROMPT}/(main|viins)/}"
                if (( ${+RPROMPT_CMDS} )); then
                    for cmd in $RPROMPT_CMDS; do
                        local_prompt+="$($cmd)"
                    done
                fi
                RPROMPT="$local_prompt$(git_super_status)"
                zle reset-prompt
            fi
            ;;
        ('cont')
            ;;
        ('select')
            ;;
        ('vared')
            ;;
        }
}

zle -N zle-line-init
zle -N zle-keymap-select
export KEYTIMEOUT=100
bindkey -v
#}}}
#prompt {{{
prompt_adam2_setup () { #{{{
    # Some can't be local
    local prompt_gfx_tlc prompt_gfx_blc

    prompt_start=$'%{\e(0%}'
    prompt_end=$'%{\e(B%}'
    prompt_gfx_tlc=$prompt_start┌$prompt_end
    prompt_gfx_blc=$prompt_start└$prompt_end
    prompt_gfx_hyphen=─
    local phyph=$prompt_start$prompt_gfx_hyphen$prompt_end


    case $HOST in #hyphens
        (*[Mm]use*)
            prompt_adam2_color1=${1:-'green'};; # green
        (*karkinos*)
            prompt_adam2_color1=${1:-'#FF7700'};; # orange
        (localhost)
            prompt_adam2_color1=${1:-'magenta'};;
        (raspberrypi|black-pearl)
            prompt_adam2_color1=${1:-'198'};; # pink
        (*prod*)
            prompt_adam2_color1=${1:-'#FF0000'};;
        (*dev*)
            prompt_adam2_color1=${1:-'blue'};;
        (*)
            prompt_adam2_color1=${1:-'154'};; # lime
    esac
    # Colour scheme
    prompt_adam2_color2=${2:-'green'}   # current directory
    prompt_adam2_color3=${3:-'cyan'}    # user@host
    prompt_adam2_color4=${4:-'12'}   # user input

    local prompt_gfx_bbox
    prompt_gfx_tbox="%B%F{$prompt_adam2_color1}${prompt_gfx_tlc}%b%F{$prompt_adam2_color1}${phyph}"
    prompt_gfx_bbox="%B%F{$prompt_adam2_color1}${prompt_gfx_blc}%b%F{$prompt_adam2_color1}${phyph}"

    # This is a cute hack.  Well I like it, anyway.

    prompt_l_paren="%B%F{246}("
    prompt_r_paren="%B%F{246})"
    prompt_l_sqparen="%B%F{246}["
    prompt_r_sqparen="%B%F{246}]"

    prompt_user_host="%b%F{$prompt_adam2_color3}%n%B%F{$prompt_adam2_color3}@%b%F{$prompt_adam2_color3}%m"
    prompt_shell_level="%b%F{yellow}l:$SHLVL%B%F{246}"
    prompt_jobs="%b%F{yellow}j:%j%B%F{246}"

    prompt_line_1a="$prompt_gfx_tbox$prompt_l_paren%B%F{$prompt_adam2_color2}%~$prompt_r_paren%b%F{$prompt_adam2_color1}"
    prompt_line_1b="%B%F{246}[%b%F{yellow}%D{%H:%M}%B%F{246}|$prompt_user_host%B%F{246}|$prompt_shell_level $prompt_jobs]%b%F{$prompt_adam2_color1}${phyph}"
    # Cache right-side width: static per session (user@host, shlvl don't change)
    prompt_line_1b_width=${#${(S%%)prompt_line_1b//(\%([KF1]|)\{*\}|\%[Bbkf])}}

    prompt_line_2="$prompt_gfx_bbox$prompt_l_sqparen%b%F{12}%?$prompt_r_sqparen%b%F{$prompt_adam2_color1}${phyph}%b%F{12}"

    prompt_char="%(!.#.>)"

    prompt_opts=(cr subst percent)

} #}}}
before_command() { #{{{
    EXIT_CODE=$?
    if ! [[ -z $CMD_START_DATE ]]; then
        # The idea for this comes from https://glasnt.com/blog/on-audible-notification-of-long-running-commands
        CMD_END_DATE=$EPOCHSECONDS
        # altered from https://stackoverflow.com/questions/5203665/zsh-check-if-string-is-in-array
        if ! [[ $LONG_CMD_IGNORED[(r)${CMD_ARRAY[1]}] ]]; then  # See zshparam:Subscript Flags
            CMD_ELAPSED_TIME=$(($CMD_END_DATE - $CMD_START_DATE))
            unset CMD_START_DATE
            if [[ $CMD_ELAPSED_TIME -gt $LONG_CMD_NOTIFY_THRESHOLD ]]; then

                RES="$(( CMD_ELAPSED_TIME / 60 )) min, $(( CMD_ELAPSED_TIME % 60 )) sec"
                if [[ $EXIT_CODE == 0 ]]; then
                    result="${CMD_ARRAY[1]} completed."
                else
                    result="${CMD_ARRAY[1]} failed. Exit code, $EXIT_CODE."
                fi
                echo -e "\n⏰  $result $RES" >&2
                if (( $+commands[it2attention] )); then
                    it2attention start
                    it2attention fireworks
                fi
                (
                    if [[ $TERM == tmux* ]]; then
                        printf "\033Ptmux;\033"
                    fi
                    printf "\033]1337;Custom=id=%s:%s\a" "longrun" "$result"
                    if [[ $TERM == tmux* ]]; then
                        printf "\033\\"
                    fi

                    if (( $+commands[espeak] )); then
                        espeak -s 600 $result &
                    fi

                    # ntfy push, fire-and-forget. 3x gate (matches the old
                    # Join behaviour): the phone only pings for genuinely long
                    # commands — local notifications already fired at 1x.
                    # The topic is a capability secret (knowing it = read and
                    # write): resolved from NTFY_TOPIC (containers/headless,
                    # injected at provision time) or the OS keychain
                    # ('secret get ntfy-topic'), never from any repo.
                    # NTFY_SERVER overrides for a self-hosted instance.
                    if [[ $CMD_ELAPSED_TIME -gt $(( 3 * $LONG_CMD_NOTIFY_THRESHOLD )) ]]; then
                        local ntfy_topic=${NTFY_TOPIC:-}
                        if [[ -z $ntfy_topic ]] && (( $+commands[secret] )); then
                            ntfy_topic=$(secret get ntfy-topic 2> /dev/null) || ntfy_topic=""
                        fi
                        if [[ -n $ntfy_topic ]]; then
                            # Optional bearer token — required once NTFY_SERVER
                            # points at a self-hosted deny-all instance
                            local ntfy_token=${NTFY_TOKEN:-}
                            if [[ -z $ntfy_token ]] && (( $+commands[secret] )); then
                                ntfy_token=$(secret get ntfy-token 2> /dev/null) || ntfy_token=""
                            fi
                            local -a ntfy_auth=()
                            [[ -n $ntfy_token ]] && ntfy_auth=(-H "Authorization: Bearer $ntfy_token")
                            curl -s -m 5 "${ntfy_auth[@]}" \
                                -H "Title: long command finished" \
                                -d "$result $RES" \
                                "${NTFY_SERVER:-https://ntfy.sh}/$ntfy_topic" \
                                &> /dev/null &!
                        fi
                    fi
                )
            fi
        fi
    fi
    local prompt_line_1

    prompt_adam2_choose_prompt

    print -rP "$prompt_line_1"
    PS1="$prompt_line_2%b%F{12}$prompt_char %b%f%k"
    PS2="$prompt_line_2$prompt_gfx_bbox_to_mbox%b%F{12}%_> %b%f%k"
    PS3="$prompt_line_2$prompt_gfx_bbox_to_mbox%b%F{12}?# %b%f%k"

    zle_highlight[(r)default:*]="default:fg=$prompt_adam2_color4"
}

autoload -Uz add-zsh-hook
add-zsh-hook precmd before_command

#}}}

# Use OMZL termsupport re-do for my custom tmux-256color {{{
function title {
  setopt localoptions nopromptsubst

  # Don't set the title if inside emacs, unless using vterm
  [[ -n "${INSIDE_EMACS:-}" && "$INSIDE_EMACS" != vterm ]] && return

  # if $2 is unset use $1 as default
  # if it is set and empty, leave it as is
  : ${2=$1}

  case "$TERM" in
    cygwin|xterm*|putty*|rxvt*|konsole*|ansi|mlterm*|alacritty|st*|foot|contour*)
      print -Pn "\e]2;${2:q}\a" # set window name
      print -Pn "\e]1;${1:q}\a" # set tab name
      ;;
    screen*)
      print -Pn "\ek${1:q}\e\\" # set screen hardstatus
      ;;
    *)
      if [[ "$TERM_PROGRAM" == "iTerm.app" ]]; then
        print -Pn "\e]2;${2:q}\a" # set window name
        print -Pn "\e]1;${1:q}\a" # set tab name
      else
        # Try to use terminfo to set the title if the feature is available
        if (( ${+terminfo[fsl]} && ${+terminfo[tsl]} )); then
          print -Pn "${terminfo[tsl]}$1${terminfo[fsl]}"
        fi
      fi
      ;;
  esac
}
#}}}

# Terminal title hooks (was OMZL::termsupport.zsh) {{{
ZSH_THEME_TAB_TITLE="%15<..<%~%<<"
ZSH_THEME_WINDOW_TITLE="%n@%m:%~"

# Prompt title: truncated pwd in tab, user@host:~ in window
# Override term_title_precmd in ~/.local_zshrc for per-env customisation
function term_title_precmd {
    [[ "${DISABLE_AUTO_TITLE:-}" != true ]] || return
    title "$ZSH_THEME_TAB_TITLE" "$ZSH_THEME_WINDOW_TITLE"
}

# Running command in tab title
function term_title_preexec {
    [[ "${DISABLE_AUTO_TITLE:-}" != true ]] || return
    emulate -L zsh
    setopt extended_glob

    local -a cmdargs
    cmdargs=("${(z)2}")
    if [[ "${cmdargs[1]}" = fg ]]; then
        local job_id jobspec="${cmdargs[2]#%}"
        case "$jobspec" in
            <->) job_id=${jobspec} ;;
            ""|%|+) job_id=${(k)jobstates[(r)*:+:*]} ;;
            -) job_id=${(k)jobstates[(r)*:-:*]} ;;
            [?]*) job_id=${(k)jobtexts[(r)*${(Q)jobspec}*]} ;;
            *) job_id=${(k)jobtexts[(r)${(Q)jobspec}*]} ;;
        esac
        if [[ -n "${jobtexts[$job_id]}" ]]; then
            1="${jobtexts[$job_id]}"
            2="${jobtexts[$job_id]}"
        fi
    fi

    local CMD="${1[(wr)^(*=*|sudo|ssh|mosh|rake|-*)]:gs/%/%%}"
    local LINE="${2:gs/%/%%}"
    title "$CMD" "%100>...>${LINE}%<<"
}

if [[ -z "$INSIDE_EMACS" || "$INSIDE_EMACS" = vterm ]]; then
    add-zsh-hook precmd term_title_precmd
    add-zsh-hook preexec term_title_preexec
fi
#}}}

prompt_adam2_choose_prompt () { #{{{
    local prompt_line_1a_width=${#${(S%%)prompt_line_1a//(\%([KF1]|)\{*\}|\%[Bbkf])}}

    local prompt_padding_size=$(( COLUMNS
    - prompt_line_1a_width
    - prompt_line_1b_width ))

    # Try to fit in long path and user@host.
    if (( prompt_padding_size > 0 )); then
        local prompt_padding
        eval "prompt_padding=\${(l:${prompt_padding_size}::${prompt_gfx_hyphen}:)_empty_zz}"
        prompt_line_1="$prompt_line_1a$prompt_start$prompt_padding$prompt_end$prompt_line_1b"
        return
    fi

    prompt_padding_size=$(( COLUMNS - prompt_line_1a_width ))

    # Didn't fit; try to fit in just long path.
    if (( prompt_padding_size > 0 )); then
        local prompt_padding
        eval "prompt_padding=\${(l:${prompt_padding_size}::${prompt_gfx_hyphen}:)_empty_zz}"
        prompt_line_1="$prompt_line_1a$prompt_start$prompt_padding$prompt_end"
        return
    fi

    # Still didn't fit; truncate
    local prompt_pwd_size=$(( COLUMNS - 5 ))
    prompt_line_1="$prompt_gfx_tbox$prompt_l_paren%B%F{$prompt_adam2_color2}%$prompt_pwd_size<...<%~%<<$prompt_r_paren%b%F{$prompt_adam2_color1}$prompt_start$prompt_gfx_hyphen$prompt_end"
} #}}}
before_execute() { #{{{
    print -Pn "%B%F{}Start %D{%H:%M:%S}\n%b%f%k"
    CMD_NAME=$1
    echo $1 | read -A CMD_ARRAY
    CMD_START_DATE=$EPOCHSECONDS
}

autoload -Uz add-zsh-hook
add-zsh-hook preexec before_execute

#}}}


prompt_adam2_setup
#}}}
#}}}
