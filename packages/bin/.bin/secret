#!/usr/bin/env bash
# secret — seed secrets from 1Password into the OS keychain once, then read
# them fast and non-interactively forever after (daemons included).
#
#   secret get <name>                    print the secret (keychain read, ~ms)
#   secret set <name> [op://ref] [@acct] store: from the op ref, from stdin
#                                        ("-"), or prompted (no echo)
#   secret rm <name>                     remove the entry
#   secret ls [mapfile]                  map entries + whether each is seeded
#   secret seed [mapfile]                `op read` every map entry into the
#                                        keychain (the only interactive step)
#
# Map file (default ~/.config/dots/secrets.map, shipped by the side-car):
#   <name> <op://vault/item/field> [@account]   # one per line, # comments ok
#
# The ref runs to the end of the line, so item and field names may contain
# spaces unquoted. An optional trailing `@<account>` picks the 1Password
# account (shorthand, sign-in address, account ID or user ID — see
# `op account list`). Give it whenever more than one account is signed in:
# vault names such as "Private" are not unique across accounts. Without it
# op resolves against OP_ACCOUNT, else its own default account.
#
# macOS: login-keychain generic passwords (service=<name>, account=dots).
# Items are created AND read by /usr/bin/security, so its keychain ACL allows
# silent reads — no per-access prompt. Unlocked at login; that is the one
# requirement for background readers (launchd agents run in your session).
# Linux: secret-tool/libsecret (same caveat: an unlocked session keyring).

set -euo pipefail

die()  { printf 'secret: error: %s\n' "$*" >&2; exit 1; }
info() { printf 'secret: %s\n' "$*"; }

MAP_DEFAULT="${XDG_CONFIG_HOME:-$HOME/.config}/dots/secrets.map"
ACCOUNT="dots"

backend=""
if [ "$(uname -s)" = "Darwin" ]; then
    backend=keychain
elif command -v secret-tool >/dev/null 2>&1; then
    backend=libsecret
else
    die "no secret backend (macOS security / Linux secret-tool); headless boxes: keep plain side-car files instead"
fi

kc_get() {
    case "$backend" in
        keychain)  security find-generic-password -a "$ACCOUNT" -s "$1" -w 2>/dev/null ;;
        libsecret) secret-tool lookup service "$1" account "$ACCOUNT" 2>/dev/null ;;
    esac
}

kc_set() {  # $1 name, $2 value
    case "$backend" in
        keychain)  security add-generic-password -U -a "$ACCOUNT" -s "$1" -w "$2" ;;
        libsecret) printf '%s' "$2" | secret-tool store --label "dots: $1" service "$1" account "$ACCOUNT" ;;
    esac
}

kc_rm() {
    case "$backend" in
        keychain)  security delete-generic-password -a "$ACCOUNT" -s "$1" >/dev/null ;;
        libsecret) secret-tool clear service "$1" account "$ACCOUNT" ;;
    esac
}

op_read() {  # $1 op:// ref, $2 account (empty -> OP_ACCOUNT / op's default)
    command -v op >/dev/null 2>&1 || die "1Password CLI (op) not installed"
    if [ -n "${2:-}" ]; then
        op --account "$2" read "$1"
    else
        op read "$1"
    fi
}

# Split one map line into ent_name / ent_ref / ent_acct. The ref keeps any
# internal whitespace ("op://Employee/My Item/token"); only a trailing
# @account token is peeled off it.
parse_entry() {
    ent_name="" ent_ref="" ent_acct=""
    [[ $1 =~ ^[[:space:]]*([^[:space:]]+)([[:space:]]+(.*))?$ ]] || die "unparsable map line: $1"
    ent_name=${BASH_REMATCH[1]}
    ent_ref=${BASH_REMATCH[3]:-}
    if [[ $ent_ref =~ ^(.*[^[:space:]])[[:space:]]+@([^[:space:]]+)$ ]]; then
        ent_ref=${BASH_REMATCH[1]}
        ent_acct=${BASH_REMATCH[2]}
    elif [[ $ent_ref =~ ^@([^[:space:]]+)$ ]]; then
        die "map entry '$ent_name' has an account but no reference"
    fi
    [ -n "$ent_ref" ] || die "map entry '$ent_name' has no reference"
}

map_entries() {  # $1 mapfile -> "name ref [@account]" lines
    [ -f "$1" ] || die "no map file at $1 (the side-car ships it)"
    sed -e 's/#.*//' -e 's/[[:space:]]*$//' -e '/^$/d' "$1"
}

cmd=${1:-help}
shift || true
case "$cmd" in
    get)
        [ $# -eq 1 ] || die "usage: secret get <name>"
        kc_get "$1" || die "'$1' not seeded — run: secret set $1 <op://ref> [@account], or secret seed"
        ;;
    set)
        [ $# -ge 1 ] && [ $# -le 3 ] || die "usage: secret set <name> [op://ref|-] [@account]"
        name=$1 src=${2:-} acct=${3:-}
        acct=${acct#@}
        case "$src" in
            op://*)
                value=$(op_read "$src" "$acct") || die "op read failed for $src${acct:+ (account $acct)}" ;;
            -)  [ -z "$acct" ] || die "an account only applies to an op:// reference"
                value=$(cat) ;;
            "") [ -z "$acct" ] || die "an account only applies to an op:// reference"
                printf 'value for %s (no echo): ' "$name" >&2
                read -rs value; printf '\n' >&2 ;;
            *)  die "second argument must be an op:// reference or '-' for stdin" ;;
        esac
        [ -n "$value" ] || die "empty value — not storing"
        kc_set "$name" "$value"
        info "stored '$name' in the $backend"
        ;;
    rm)
        [ $# -eq 1 ] || die "usage: secret rm <name>"
        kc_rm "$1" && info "removed '$1'"
        ;;
    ls)
        map=${1:-$MAP_DEFAULT}
        while IFS= read -r line; do
            parse_entry "$line"
            if kc_get "$ent_name" >/dev/null; then state=seeded; else state=MISSING; fi
            printf '%-9s %-28s %-52s %s\n' \
                "$state" "$ent_name" "$ent_ref" "${ent_acct:-<op default>}"
        done <<EOM
$(map_entries "$map")
EOM
        ;;
    seed)
        map=${1:-$MAP_DEFAULT}
        command -v op >/dev/null 2>&1 || die "1Password CLI (op) not installed"
        fails=0
        while IFS= read -r line; do
            parse_entry "$line"
            case "$ent_ref" in
                op://*) ;;
                *) info "skipping '$ent_name' (ref is not op://)"; continue ;;
            esac
            if value=$(op_read "$ent_ref" "$ent_acct") && [ -n "$value" ]; then
                kc_set "$ent_name" "$value"
                info "seeded '$ent_name'${ent_acct:+ from $ent_acct}"
            else
                info "FAILED '$ent_name' ($ent_ref${ent_acct:+, account $ent_acct})"
                fails=$((fails + 1))
            fi
        done <<EOM
$(map_entries "$map")
EOM
        [ "$fails" -eq 0 ] || die "$fails entries failed"
        ;;
    help|-h|--help)
        sed -n '2,27p' "$0" | sed 's/^# \{0,1\}//'
        ;;
    *)
        die "unknown command '$cmd' (see: secret help)"
        ;;
esac
